# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Dipakai HANYA di server (app/api/contact/route.ts) untuk menulis pesan kontak
# setelah token Turnstile lolos verifikasi. Kunci ini melewati seluruh aturan RLS,
# jadi tidak boleh diberi awalan NEXT_PUBLIC_ dan tidak boleh dibagikan.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare Turnstile — https://dash.cloudflare.com → Turnstile → Add site
# Site key bersifat publik dan ikut ke browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# Secret key hanya dipakai di server untuk memverifikasi token ke Cloudflare.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
